# ─── CLIENT CONFIGURATION (Vite) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:5055

# ─── SERVER CONFIGURATION (Express + MongoDB) ──────────────────────────────────
NODE_ENV=development
PORT=5055

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=lh-studio-api
JWT_AUDIENCE=lh-studio-client

# Allowed browser origins (comma separated, no trailing slash).
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Refresh-token cookie policy.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Reverse-proxy hops to trust for client IPs.
TRUST_PROXY=0

# One-time initial owner bootstrap
BOOTSTRAP_TOKEN=your_bootstrap_token_min_16_characters
INVITE_EXPIRES_DAYS=7

# Rate limits
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_MIN=60
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_MIN=15
RATE_LIMIT_API_MAX=300
RATE_LIMIT_FINANCE_WRITE_MAX=20

BODY_LIMIT=512kb
