# ─── LH Studio API — environment variables ─────────────────────────────────────
# Copy to .env for local development. Never commit real values.

NODE_ENV=development
# 5000 is already used by another service on the dev machine; the client defaults to 5055.
PORT=5055

# MongoDB Atlas connection string. Must point to a replica set (Atlas always is):
# payments use multi-document transactions.
MONGO_URI=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=lh-studio-api
JWT_AUDIENCE=lh-studio-client

# Allowed browser origins (comma separated, no trailing slash).
CLIENT_URL=http://localhost:5173

# Refresh-token cookie policy.
#   Local dev (same site, http):      COOKIE_SECURE=false COOKIE_SAMESITE=lax
#   Render *.onrender.com (cross-site): COOKIE_SECURE=true  COOKIE_SAMESITE=none
#   Custom domains app./api.yourdomain: COOKIE_SECURE=true  COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Reverse-proxy hops to trust for client IPs. Render = 1, local = 0.
TRUST_PROXY=0

# One-time initial owner bootstrap: while no studio exists, /register accepts this
# token to create the studio and its owner. Remove it after the first owner exists.
BOOTSTRAP_TOKEN=
INVITE_EXPIRES_DAYS=7

# Rate limits (in-memory store: valid for a single instance only).
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_MIN=60
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_MIN=15
RATE_LIMIT_API_MAX=300
RATE_LIMIT_FINANCE_WRITE_MAX=20

BODY_LIMIT=512kb
